# Halaman formulir publik: /form/<alamat-formulir>
Options -Indexes
<FilesMatch "^_">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /form/
RewriteRule ^$ /articles/ [R=302,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([A-Za-z0-9][A-Za-z0-9-]*)/?$ view.php?slug=$1 [L,QSA]
</IfModule>
